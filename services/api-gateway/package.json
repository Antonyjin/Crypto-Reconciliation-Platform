{
  "name": "@app/api-gateway",
  "version": "1.0.0",
  "description": "REST/gRPC API gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/main.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.ts --runInBand"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^25.9.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
